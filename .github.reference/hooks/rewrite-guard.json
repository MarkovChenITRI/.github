{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File .github/.github.reference/scripts/rewrite-guard.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/.github.reference/scripts/rewrite-guard.ps1",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File .github/.github.reference/scripts/rewrite-guard.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/.github.reference/scripts/rewrite-guard.ps1",
        "timeout": 15
      }
    ]
  }
}